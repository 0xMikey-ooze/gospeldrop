# =============================================================================
# GospelDrop Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/gospeldrop"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Full URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Email address of the admin user
ADMIN_EMAIL="admin@gospeldrop.org"

# -----------------------------------------------------------------------------
# Email / SMTP (optional — fallback to JSON transport if not set)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# Set to "true" for port 465 (SSL), leave empty/false for STARTTLS
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# From address shown on outgoing emails
EMAIL_FROM="noreply@gospeldrop.org"

# -----------------------------------------------------------------------------
# Rate limiting (optional — uses in-memory defaults if not set)
# -----------------------------------------------------------------------------
# Max requests per window per IP on standard routes
RATE_LIMIT_MAX="100"
# Window duration in seconds
RATE_LIMIT_WINDOW_SECONDS="60"
# Max requests per window for auth endpoints
RATE_LIMIT_AUTH_MAX="10"
